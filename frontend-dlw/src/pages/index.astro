---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/layout/Hero.astro";
import Features from "../components/layout/Features.astro";
import Footer from "../components/layout/Footer.astro";
import { Downloader } from "../components/react/Downloader";
---

<Layout title="Descarga la wea">
  <Header />

  <main class="flex-1 flex flex-col justify-start @container z-10 relative">
    <div
      class="flex flex-col items-center justify-center gap-4 px-4 pb-10 w-full"
    >
      <Hero />
      <Downloader client:load />
    </div>

    <!-- <Features /> -->
  </main>

  <Footer />
</Layout>
