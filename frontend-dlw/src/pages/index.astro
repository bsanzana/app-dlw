---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/layout/Hero.astro";
import Features from "../components/layout/Features.astro";
import Footer from "../components/layout/Footer.astro";
import { Downloader } from "../components/react/Downloader";
---

<Layout 
  title="Descarga La Wea | Descargar Videos y Música Gratis, Rápido y en HD"
  description="Descarga videos y audios de YouTube, TikTok, Instagram y más en MP4 (1080p, 4K) o MP3 de alta calidad. Rápido, fácil, gratis y sin publicidad."
>
  <Header />

  <main class="flex-1 flex flex-col justify-start @container z-10 relative">
    <div
      class="flex flex-col items-center justify-center gap-4 px-4 pb-6 w-full"
    >
      <Hero />
      <Downloader client:load />
      <Features />
    </div>
  </main>

  <Footer />
</Layout>
