---
---

<div
  class="flex flex-col gap-10 px-4 py-16 mt-10 border-t border-border-color/50 bg-surface/30 rounded-2xl mx-4 mb-10"
>
  <div class="flex flex-col gap-2 text-center">
    <h2 class="text-slate-100 text-2xl font-bold uppercase tracking-widest">
      Especificaciones del Protocolo
    </h2>
  </div>
  <div
    class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-6 p-0 max-w-[1000px] mx-auto w-full"
  >
    <div
      class="flex flex-col gap-4 rounded-xl border border-border-color bg-surface p-6 hover:border-primary/50 transition-colors group"
    >
      <div
        class="text-primary w-12 h-12 flex items-center justify-center rounded-lg bg-primary/10 group-hover:bg-primary/20 transition-colors"
      >
        <span class="material-symbols-outlined text-3xl">speed</span>
      </div>
      <div class="flex flex-col gap-2">
        <h3 class="text-slate-100 text-lg font-bold uppercase tracking-wide">
          Hiper-Velocidad
        </h3>
        <p class="text-slate-400 text-sm font-normal leading-relaxed">
          Conexiones multi-hilo que aseguran la máxima utilización del ancho de banda para una adquisición rápida.
        </p>
      </div>
    </div>
    <div
      class="flex flex-col gap-4 rounded-xl border border-border-color bg-surface p-6 hover:border-cyan-400/50 transition-colors group"
    >
      <div
        class="text-cyan-400 w-12 h-12 flex items-center justify-center rounded-lg bg-cyan-400/10 group-hover:bg-cyan-400/20 transition-colors"
      >
        <span class="material-symbols-outlined text-3xl">security</span>
      </div>
      <div class="flex flex-col gap-2">
        <h3 class="text-slate-100 text-lg font-bold uppercase tracking-wide">
          Modo Sigilo
        </h3>
        <p class="text-slate-400 text-sm font-normal leading-relaxed">
          El cifrado de extremo a extremo oculta tu huella digital durante las operaciones de extracción.
        </p>
      </div>
    </div>
    <div
      class="flex flex-col gap-4 rounded-xl border border-border-color bg-surface p-6 hover:border-purple-400/50 transition-colors group"
    >
      <div
        class="text-purple-400 w-12 h-12 flex items-center justify-center rounded-lg bg-purple-400/10 group-hover:bg-purple-400/20 transition-colors"
      >
        <span class="material-symbols-outlined text-3xl">block</span>
      </div>
      <div class="flex flex-col gap-2">
        <h3 class="text-slate-100 text-lg font-bold uppercase tracking-wide">
          Cero Interferencia
        </h3>
        <p class="text-slate-400 text-sm font-normal leading-relaxed">
          Interfaz limpia y libre de interrupciones comerciales o algoritmos de seguimiento.
        </p>
      </div>
    </div>
  </div>
</div>
